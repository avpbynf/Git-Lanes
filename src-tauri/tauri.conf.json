{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Lanes",
  "identifier": "dev.gitlanes.app",
  "build": {
    "frontendDist": "../web/dist",
    "beforeDevCommand": {
      "script": "bun run build",
      "cwd": "../web"
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../web"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Git Lanes",
        "width": 1120,
        "height": 520,
        "minWidth": 720,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
